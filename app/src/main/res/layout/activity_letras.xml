<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/background_content"
            android:padding="@dimen/padding_screen">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/titulo_letras"
                android:textSize="@dimen/text_size_label"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/txtLetrasNombreProyecto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_large"
                android:textSize="@dimen/text_size_title"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <!-- Selector de sección (Verso, Estribillo, etc.) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_seccion_letra"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_label" />

            <Spinner
                android:id="@+id/spinnerSeccionLetra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                android:entries="@array/secciones_letra" />

            <!-- Texto de la estrofa -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_contenido_letra"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_label" />

            <EditText
                android:id="@+id/edtContenidoLetra"
                android:layout_width="match_parent"
                android:layout_height="@dimen/idea_height"
                android:layout_marginBottom="@dimen/margin_medium"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:hint="@string/hint_contenido_letra"
                android:background="@color/white"
                android:padding="@dimen/margin_small"
                android:textColor="@color/texto_oscuro"
                android:textColorHint="@color/texto_hint"/>

            <Button
                android:id="@+id/btnAgregarSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_large"
                android:backgroundTint="@color/button_add"
                android:textColor="@color/text_on_button"
                android:text="@string/boton_agregar_seccion" />

            <!-- Aquí se irán agregando las estrofas creadas -->
            <LinearLayout
                android:id="@+id/contenedorSeccionesLetra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/margin_large" />

            <Button
                android:id="@+id/btnGuardarLetras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/button_primary"
                android:textColor="@color/text_on_button"
                android:text="@string/boton_guardar_letras" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>